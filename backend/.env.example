# Backend Service-to-Service Authentication Environment

# Azure Entra AD Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend Service Client Secret (for service-to-service M2M)
# Used when backend needs to call other services/APIs as itself
AZURE_CLIENT_SECRET=your-client-secret-here
