# Microsoft Entra AD Configuration
# Get these values from Azure Portal > App registrations

# Your Azure Application (client) ID
VITE_AZURE_CLIENT_ID=your-client-id-here

# Your Azure Authority (Directory tenant ID or domain)
# Format: https://login.microsoftonline.com/{tenant-id}
# or: https://login.microsoftonline.com/{organization-domain}
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Your redirect URI (must match the one registered in Azure)
VITE_AZURE_REDIRECT_URI=http://localhost:5173/
